{
  "name": "100apps-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "create:tool": "node scripts/create-tool.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:content": "node scripts/check-content.mjs",
    "release:post": "node scripts/generate-release-post.mjs",
    "release:x": "node scripts/post-to-x.mjs",
    "release:due": "node scripts/release-schedule.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "test": "jest",
    "test:packages": "jest packages && npm run test:release",
    "check": "npm run check:architecture && npm run check:content && npm run test:packages && npm run lint && npm run build",
    "dev:portal": "npm --workspace apps/portal run dev",
    "build:portal": "npm --workspace apps/portal run build",
    "dev:dynamic-pricing": "npm --workspace apps/001-dynamic-pricing run dev",
    "build:dynamic-pricing": "npm --workspace apps/001-dynamic-pricing run build",
    "lint:portal": "npm --workspace apps/portal run lint",
    "lint:dynamic-pricing": "npm --workspace apps/001-dynamic-pricing run lint",
    "lint:social-text-formatter": "eslint packages/social-text-formatter",
    "lint:email-signature-generator": "eslint packages/email-signature-generator",
    "lint:review-reply-builder": "eslint packages/review-reply-builder",
    "lint:lp-structure-builder": "eslint packages/lp-structure-builder",
    "lint:routine-task-loop": "eslint packages/routine-task-loop",
    "lint:image-resizer": "eslint packages/image-resizer",
    "lint:shopify-csv-checker": "eslint packages/shopify-csv-checker",
    "lint:utm-link-builder": "eslint packages/utm-link-builder",
    "lint:focus-cost-timer": "eslint packages/focus-cost-timer",
    "lint:contrast-color-fixer": "eslint packages/contrast-color-fixer",
    "dev": "npx concurrently \"npm run dev:portal\" \"npm run dev:dynamic-pricing\"",
    "lint": "npm run lint:portal && npm run lint:dynamic-pricing && npm run lint:social-text-formatter && npm run lint:email-signature-generator && npm run lint:review-reply-builder && npm run lint:lp-structure-builder && npm run lint:routine-task-loop && npm run lint:image-resizer && npm run lint:shopify-csv-checker && npm run lint:utm-link-builder && npm run lint:focus-cost-timer && npm run lint:contrast-color-fixer",
    "build": "npm run build:portal && npm run build:dynamic-pricing"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.5.0"
  }
}
