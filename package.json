{
  "name": "100apps-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "create:tool": "node scripts/create-tool.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:content": "node scripts/check-content.mjs",
    "release:post": "node scripts/generate-release-post.mjs",
    "release:x": "node scripts/post-to-x.mjs",
    "release:due": "node scripts/release-schedule.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "test": "jest",
    "test:packages": "jest packages && npm run test:release",
    "check": "npm run check:architecture && npm run check:content && npm run test:packages && npm run lint && npm run build",
    "dev:portal": "npm --workspace apps/portal run dev",
    "build:portal": "npm --workspace apps/portal run build",
    "dev:dynamic-pricing": "npm --workspace apps/001-dynamic-pricing run dev",
    "build:dynamic-pricing": "npm --workspace apps/001-dynamic-pricing run build",
    "lint:portal": "npm --workspace apps/portal run lint",
    "lint:dynamic-pricing": "npm --workspace apps/001-dynamic-pricing run lint",
    "lint:social-text-formatter": "eslint packages/social-text-formatter",
    "lint:email-signature-generator": "eslint packages/email-signature-generator",
    "lint:review-reply-builder": "eslint packages/review-reply-builder",
    "lint:lp-structure-builder": "eslint packages/lp-structure-builder",
    "lint:routine-task-loop": "eslint packages/routine-task-loop",
    "lint:image-resizer": "eslint packages/image-resizer",
    "lint:shopify-csv-checker": "eslint packages/shopify-csv-checker",
    "lint:utm-link-builder": "eslint packages/utm-link-builder",
    "lint:focus-cost-timer": "eslint packages/focus-cost-timer",
    "lint:contrast-color-fixer": "eslint packages/contrast-color-fixer",
    "lint:csv-diff-checker": "eslint packages/csv-diff-checker",
    "lint:email-subject-previewer": "eslint packages/email-subject-previewer",
    "lint:invoice-pdf-generator": "eslint packages/invoice-pdf-generator",
    "lint:merchant-feed-checker": "eslint packages/merchant-feed-checker",
    "lint:redirect-map-checker": "eslint packages/redirect-map-checker",
    "lint:csv-encoding-fixer": "eslint packages/csv-encoding-fixer",
    "lint:subtitle-timing-fixer": "eslint packages/subtitle-timing-fixer",
    "lint:youtube-chapter-maker": "eslint packages/youtube-chapter-maker",
    "lint:business-day-calculator": "eslint packages/business-day-calculator",
    "lint:csv-column-mapper": "eslint packages/csv-column-mapper",
    "lint:csv-duplicate-cleaner": "eslint packages/csv-duplicate-cleaner",
    "lint:csv-rule-validator": "eslint packages/csv-rule-validator",
    "lint:csv-joiner": "eslint packages/csv-joiner",
    "lint:har-sanitizer": "eslint packages/har-sanitizer",
    "lint:pwa-manifest-checker": "eslint packages/pwa-manifest-checker",
    "lint:csv-pivot-reshape": "eslint packages/csv-pivot-reshape",
    "lint:reorder-point-calculator": "eslint packages/reorder-point-calculator",
    "lint:free-shipping-threshold-calculator": "eslint packages/free-shipping-threshold-calculator",
    "lint:ogp-card-preview": "eslint packages/ogp-card-preview",
    "lint:robots-sitemap-checker": "eslint packages/robots-sitemap-checker",
    "lint:calendar-csv-ics-converter": "eslint packages/calendar-csv-ics-converter",
    "dev": "npx concurrently \"npm run dev:portal\" \"npm run dev:dynamic-pricing\"",
    "lint": "npm run lint:portal && npm run lint:dynamic-pricing && npm run lint:social-text-formatter && npm run lint:email-signature-generator && npm run lint:review-reply-builder && npm run lint:lp-structure-builder && npm run lint:routine-task-loop && npm run lint:image-resizer && npm run lint:shopify-csv-checker && npm run lint:utm-link-builder && npm run lint:focus-cost-timer && npm run lint:contrast-color-fixer && npm run lint:csv-diff-checker && npm run lint:email-subject-previewer && npm run lint:invoice-pdf-generator && npm run lint:merchant-feed-checker && npm run lint:redirect-map-checker && npm run lint:csv-encoding-fixer && npm run lint:subtitle-timing-fixer && npm run lint:youtube-chapter-maker && npm run lint:business-day-calculator && npm run lint:csv-column-mapper && npm run lint:calendar-csv-ics-converter && npm run lint:robots-sitemap-checker && npm run lint:ogp-card-preview && npm run lint:csv-duplicate-cleaner && npm run lint:csv-rule-validator && npm run lint:csv-joiner && npm run lint:har-sanitizer && npm run lint:pwa-manifest-checker && npm run lint:csv-pivot-reshape && npm run lint:reorder-point-calculator && npm run lint:free-shipping-threshold-calculator",
    "build": "npm run build:portal && npm run build:dynamic-pricing"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.5.0"
  }
}
